# CAVENTRA CRM — Free Firebase Spark Plan Environment Configuration
# To connect your live cloud database, obtain these from Firebase Console -> Project Settings -> General -> Web App

VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=caventra-crm.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=caventra-crm
VITE_FIREBASE_STORAGE_BUCKET=caventra-crm.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID
