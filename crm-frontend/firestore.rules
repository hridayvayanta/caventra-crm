rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for secure authorization
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }

    function isFounder() {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (getUserData(request.auth.uid).role in ['founder', 'admin']);
    }

    function isActiveUser() {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (
          getUserData(request.auth.uid).role in ['founder', 'admin'] ||
          getUserData(request.auth.uid).status == 'active'
        );
    }

    // 1. Users collection
    match /users/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || isFounder());
      allow create: if isOwner(userId) &&
        request.resource.data.role == 'employee' &&
        request.resource.data.status == 'pending_activation' &&
        request.resource.data.id == userId;
      allow update: if isFounder() || (
        isOwner(userId) &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.status == resource.data.status
      );
      allow delete: if isFounder();
    }

    // 2. Activation codes collection
    match /activationCodes/{codeId} {
      allow read, write: if isFounder();
    }

    // 3. Protected CRM collections
    match /leads/{leadId} {
      allow read, write: if isActiveUser();
    }

    match /follow_ups/{taskId} {
      allow read, write: if isActiveUser();
    }

    match /activities/{actId} {
      allow read, write: if isActiveUser();
    }

    match /import_history/{histId} {
      allow read, write: if isActiveUser();
    }

    match /ingestionJobs/{jobId} {
      allow read: if isActiveUser();
      allow write: if isFounder();
    }

    // 4. Outreach Campaigns: Only authorized founders can configure, activate, or pause campaigns
    match /campaigns/{campaignId} {
      allow read: if isActiveUser();
      allow write: if isFounder();
    }

    // 5. Email Jobs: Queue protection and anti-tamper.
    match /emailJobs/{jobId} {
      allow read: if isActiveUser();
      allow create: if isActiveUser() && 
        request.resource.data.status in ['QUEUED', 'SUPPRESSED'] &&
        request.resource.data.recipientEmail != null;
      allow update: if isFounder();
      allow delete: if isFounder();
    }

    // 6. Email Events: Append-only audit trail
    match /emailEvents/{eventId} {
      allow read: if isActiveUser();
      allow create: if isActiveUser();
      allow update, delete: if false;
    }

    // 7. Email Suppressions
    match /email_suppressions/{emailId} {
      allow read: if isActiveUser();
      allow create: if isActiveUser();
      allow update, delete: if isFounder();
    }

    // 8. Gmail OAuth Tokens & Secrets: Strictly server-side only
    match /gmail_auth/{authId} {
      allow read, write: if false;
    }
  }
}
