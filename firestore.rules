rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for secure authorization
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }

    function isFounder() {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (getUserData(request.auth.uid).role in ['founder', 'admin']);
    }

    function isActiveUser() {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (
          getUserData(request.auth.uid).role in ['founder', 'admin'] ||
          getUserData(request.auth.uid).status == 'active'
        );
    }

    // 1. Users collection
    match /users/{userId} {
      // Employees can read their own profile; Founders can read all employee profiles
      allow read: if isSignedIn() && (isOwner(userId) || isFounder());

      // On registration, an employee can create their own profile (pending or active if code supplied)
      allow create: if isOwner(userId) &&
        request.resource.data.role == 'employee' &&
        request.resource.data.status in ['pending_activation', 'active'] &&
        request.resource.data.id == userId;

      // An employee updating their own profile CANNOT alter their role.
      // Status update to active is permitted upon valid confirmation code verification.
      allow update: if isFounder() || (
        isOwner(userId) &&
        request.resource.data.role == resource.data.role
      );

      // Deletion allowed only by Founder
      allow delete: if isFounder();
    }

    // 2. Activation codes collection
    // Strictly founder-only. Employees have NO read or write access to prevent code enumeration.
    match /activationCodes/{codeId} {
      allow read, write: if isFounder();
    }

    // 3. Protected CRM collections: Strictly forbidden for pending_activation or unauthenticated users
    match /leads/{leadId} {
      allow read, write: if isActiveUser();
    }

    match /follow_ups/{taskId} {
      allow read, write: if isActiveUser();
    }

    match /activities/{actId} {
      allow read, write: if isActiveUser();
    }

    match /import_history/{histId} {
      allow read, write: if isActiveUser();
    }

    match /ingestionJobs/{jobId} {
      allow read: if isActiveUser();
      allow write: if isFounder();
    }

    // 4. Outreach Campaigns: Only authorized founders can configure, activate, or pause campaigns
    match /campaigns/{campaignId} {
      allow read: if isActiveUser();
      allow write: if isFounder();
    }

    // 5. Email Jobs: Queue protection and anti-tamper.
    // Browser employees cannot forge 'SENT' status or tamper with provider IDs.
    match /emailJobs/{jobId} {
      allow read: if isActiveUser();
      allow create: if isActiveUser() && 
        request.resource.data.status in ['QUEUED', 'SUPPRESSED'] &&
        request.resource.data.recipientEmail != null;
      // Status updates to SENT or provider modifications require founder/server authorization
      allow update: if isFounder();
      allow delete: if isFounder();
    }

    // 6. Email Events: Append-only audit trail
    match /emailEvents/{eventId} {
      allow read: if isActiveUser();
      allow create: if isActiveUser();
      allow update, delete: if false; // Immutable audit records
    }

    // 7. Email Suppressions: Read by active users; suppressions can be created on opt-out/bounce
    match /email_suppressions/{emailId} {
      allow read: if isActiveUser();
      allow create: if isActiveUser();
      allow update, delete: if isFounder();
    }

    // 8. Gmail OAuth Tokens & Secrets: Strictly server-side only.
    // Browser clients have ZERO read or write access under any circumstances.
    match /gmail_auth/{authId} {
      allow read, write: if false;
    }

    // 9. Default Deny on any unspecified collections & documents
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
