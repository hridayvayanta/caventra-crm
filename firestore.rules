rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for secure authorization
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }

    function isFounder() {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (getUserData(request.auth.uid).role in ['founder', 'admin']);
    }

    function isActiveUser() {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (
          getUserData(request.auth.uid).role in ['founder', 'admin'] ||
          getUserData(request.auth.uid).status == 'active'
        );
    }

    // 1. Users collection
    match /users/{userId} {
      // Employees can read their own profile; Founders can read all employee profiles
      allow read: if isSignedIn() && (isOwner(userId) || isFounder());

      // On registration, an employee can ONLY create their own profile with 'employee' role and 'pending_activation' status
      allow create: if isOwner(userId) &&
        request.resource.data.role == 'employee' &&
        request.resource.data.status == 'pending_activation' &&
        request.resource.data.id == userId;

      // Only a Founder can change an employee's role, status, or activation fields.
      // An employee updating their own profile CANNOT alter their status or role.
      allow update: if isFounder() || (
        isOwner(userId) &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.status == resource.data.status
      );

      // Deletion allowed only by Founder
      allow delete: if isFounder();
    }

    // 2. Activation codes collection
    // Strictly founder-only. Employees have NO read or write access to prevent code enumeration.
    match /activationCodes/{codeId} {
      allow read, write: if isFounder();
    }

    // 3. Protected CRM collections: Strictly forbidden for pending_activation or unauthenticated users
    match /leads/{leadId} {
      allow read, write: if isActiveUser();
    }

    match /follow_ups/{taskId} {
      allow read, write: if isActiveUser();
    }

    match /activities/{actId} {
      allow read, write: if isActiveUser();
    }

    match /import_history/{histId} {
      allow read, write: if isActiveUser();
    }

    match /ingestionJobs/{jobId} {
      allow read: if isActiveUser();
      allow write: if isFounder();
    }
  }
}
